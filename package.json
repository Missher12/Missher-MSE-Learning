{
  "name": "@missher/dsh-mse-learning",
  "version": "0.9.0-alpha.18",
  "private": true,
  "type": "module",
  "description": "Scoped persistent lessons with bounded context for Agent adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/Missher-MSE-Learning.git"
  },
  "homepage": "https://github.com/Missher12/Missher-MSE-Learning#readme",
  "bugs": {
    "url": "https://github.com/Missher12/Missher-MSE-Learning/issues"
  },
  "keywords": [
    "dsh-plugin",
    "persistent-learning",
    "memory",
    "agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./core": "./src/index.mjs",
    ".": "./src/root.mjs",
    "./harness": "./adapters/harness.mjs",
    "./checks": "./src/checks.mjs",
    "./evaluation": "./src/evaluation.mjs",
    "./cases": "./src/cases.mjs",
    "./adapters/dsh": "./adapters/dsh/index.mjs",
    "./status": "./src/status.mjs",
    "./recall": "./src/recall.mjs",
    "./client": "./adapters/dsh/client.js",
    "./typert": "./adapters/dsh/typert.mjs",
    "./details": "./adapters/dsh/details.mjs",
    "./project": "./adapters/dsh/project.mjs"
  },
  "bin": {
    "mse-learn": "./src/cli.mjs"
  },
  "files": [
    "src",
    "adapters/dsh",
    "adapters/harness.mjs",
    "adapters/hermes/__init__.py",
    "adapters/hermes/bridge.py",
    "adapters/hermes/plugin.yaml",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE",
    "cordis.patch.yml",
    "VALIDATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "pack:local": "node scripts/pack.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:dsh": "node scripts/pack.mjs --dsh-only"
  },
  "main": "./src/root.mjs"
}
