{
  "name": "@missher/dsh-mse-learning",
  "version": "0.16.0-rc.5",
  "description": "MSE learning (rebuilt slim chain): trusted user/tool facts → bounded recall → evidence-bound lessons → daily digest. An upgrade of the mse-learning bundle.",
  "type": "module",
  "private": true,
  "main": "./rebuild/root.mjs",
  "exports": {
    ".": "./rebuild/root.mjs",
    "./client": "./rebuild/client.js",
    "./typert": "./rebuild/typert.mjs"
  },
  "files": [
    "LICENSE",
    "README.en.md",
    "README.md",
    "adapters/dsh/usage.mjs",
    "cordis.patch.yml",
    "docs/AUTONOMY_0.15.0.md",
    "rebuild/checker.mjs",
    "rebuild/client.js",
    "rebuild/config.mjs",
    "rebuild/dsh.mjs",
    "rebuild/engine.mjs",
    "rebuild/evolution.mjs",
    "rebuild/llm.mjs",
    "rebuild/memory.mjs",
    "rebuild/recall.mjs",
    "rebuild/remote.mjs",
    "rebuild/root.mjs",
    "rebuild/time.mjs",
    "rebuild/typert.mjs",
    "src/checks.mjs",
    "src/failure-evidence.mjs",
    "src/failure-lessons.mjs",
    "src/problems.mjs",
    "src/recall.mjs",
    "src/store.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "mse",
    "learning"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/Missher-MSE-Learning.git"
  },
  "homepage": "https://github.com/Missher12/Missher-MSE-Learning#readme",
  "bugs": {
    "url": "https://github.com/Missher12/Missher-MSE-Learning/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test rebuild/rebuild.test.mjs",
    "pack:local": "node scripts/pack.mjs --dsh-only",
    "pack:dsh": "node scripts/pack.mjs --dsh-only",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
